{
  "manifestVersion": 2,
  "id": "tigexing-app",
  "name": "提个醒",
  "version": "0.1.0",
  "entry": "index.js",
  "description": "伙伴回复、模型异常中断、计划任务和巡检完成时按设置提醒，可按伙伴个性化音效，并设置提醒档位与静默时段。",
  "capabilities": [
    "app/notifications.show",
    "app/process.spawn",
    "app/models.read",
    "app/models.infer",
    "app/agents.read",
    "app/resources.read",
    "app/sessions.read"
  ],
  "contributes": {
    "cards": [
      {
        "id": "settings",
        "title": "提个醒",
        "description": "伙伴回复、模型异常中断、计划任务和巡检完成时按设置弹出通知",
        "route": "/settings.html",
        "realization": "page",
        "siteNavEntry": true,
        "cardForm": "flush",
        "face": {
          "image": "assets/icon.png"
        },
        "pageIcon": "assets/nav-icon.svg"
      }
    ]
  },
  "icon": "assets/icon.png",
  "minAppVersion": "0.1059.0"
}
