{
  "schema": 1,
  "project": {
    "id": "tigexing-app",
    "name": "提个醒",
    "kind": "app",
    "version": "0.4.1",
    "repoUrl": "moononnn/hanako-tigexing-app"
  },
  "publisher": "moononnn & 小花",
  "source": {
    "roots": [
      "."
    ]
  },
  "checks": {
    "testCommands": [],
    "deferredTo": "existing-ci + local precise verify"
  },
  "package": {
    "topLevel": "tigexing-app",
    "entry": "index.js",
    "include": [],
    "excludeDirs": [
      "tests",
      "node_modules",
      ".git",
      "_backups",
      ".github",
      "attachments",
      ".cloud-build",
      ".cache",
      "out"
    ],
    "excludeFiles": [
      ".gitattributes",
      ".gitignore",
      "PENDING_CHANGES.md",
      "PUBLISHING.md",
      "PROJECT_LOG.md",
      "TESTING.md",
      "data.json",
      "preferences.json",
      "probe-result.json",
      ".installed-by.json",
      "index.probe.js",
      "ui/probe.html",
      "lib/state-probe.js"
    ],
    "excludeGlobs": [
      "DESIGN-*.md",
      "PLAN-*.md",
      "*.log",
      "*.tmp",
      "*.dat",
      "*.corrupt-*",
      ".corrupt-*",
      "analysis-*.json",
      "taste-*.json"
    ]
  },
  "devOnly": {
    "targets": [],
    "startMark": "",
    "endMark": "",
    "residue": [],
    "replacements": []
  },
  "privacy": {
    "redlineSource": "local-only（云端不持有词表；本机用 projects/<id>.json 的 redline 扫）",
    "textExtensions": [
      ".js",
      ".mjs",
      ".cjs",
      ".json",
      ".md",
      ".html",
      ".css",
      ".txt",
      ".yml",
      ".yaml",
      ".ps1"
    ],
    "allowedNames": [
      "小花",
      "moononnn",
      "Hanako",
      "Moonon"
    ]
  },
  "resources": {
    "manifestFile": "manifest.json",
    "bases": [
      "",
      "ui/"
    ],
    "pointers": [
      "icon",
      "contributes.cards[].face.image",
      "contributes.cards[].pageIcon",
      "contributes.cards[].route"
    ]
  },
  "output": {
    "archiveBaseName": "app-tigexing-app-{version}",
    "zipExtension": ".zip"
  },
  "toolchain": {
    "packScript": "scripts/extension-pack.mjs",
    "pin": {
      "channel": "beta",
      "channelManifest": "https://dl.openhanako.com/channels/beta.json",
      "version": "1.5.7-beta",
      "platform": "win32-x64",
      "file": "server-1.5.7-beta-win32-x64.tar.gz",
      "sha256": "2a42dde5da98320078005636ebe7184c7ea3f4898038df6557bd024f0bce5a94",
      "size": 276816238,
      "mirrors": [
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-43",
        "https://dl.openhanako.com",
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-40",
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-37"
      ]
    }
  }
}
